{
  "name": "sunrin-valley-launcher",
  "version": "1.1.0",
  "description": "\uc120\ub9b0\ubc38\ub9ac \uc804\uc6a9 \uc124\uce58 \ubc0f \uc2e4\ud589 \ub3c4\uc6b0\ubbf8",
  "author": "Sunrin Valley",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:mac": "electron-builder --mac dmg --arm64 --publish never && node scripts/verify-mac-distribution.cjs",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "verify:install": "tsx scripts/verify-install.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "kr.sunrinvalley.launcher",
    "productName": "Sunrin Valley",
    "directories": {
      "output": "../release/1.1.0"
    },
    "files": [
      "out/**/*",
      "!out/sunrin-installed-files.nsh",
      "package.json"
    ],
    "afterPack": "build/after-pack.cjs",
    "extraResources": [
      {
        "from": "../client-pack/manifest.json",
        "to": "pack/manifest.json"
      },
      {
        "from": "../client-pack/prism-runtime.json",
        "to": "pack/prism-runtime.json"
      },
      {
        "from": "../resourcepacks/dist/Sunrin-Custom.zip",
        "to": "pack/Sunrin-Custom.zip"
      },
      {
        "from": "../kubejs-custom/startup_scripts/sunrin_items.js",
        "to": "pack/sunrin_items.js"
      },
      {
        "from": "../client-pack/update-source.json",
        "to": "pack/update-source.json"
      },
      {
        "from": "build/launcher-update-helper.cjs",
        "to": "launcher-update-helper.cjs"
      },
      {
        "from": "build/launcher-update-helper.ps1",
        "to": "launcher-update-helper.ps1"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "identity": "-",
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "Sunrin-Valley-${version}-mac-arm64.${ext}"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Sunrin Valley",
      "artifactName": "Sunrin-Valley-Setup-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Sunrin Valley ${version}",
      "format": "UDZO",
      "sign": false,
      "backgroundColor": "#f4f2e6",
      "iconSize": 104,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
