{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["node", "vite/client"], "noEmit": true
  },
  "include": ["src", "tests", "scripts", "electron.vite.config.ts"]
}
